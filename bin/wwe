#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""wwe - Wayland Wallpaper Engine control tool.

Runs Steam Wallpaper Engine workshop items (scene / web / video) and plain
video files as live wallpapers on Wayland:

  * GNOME (mutter has no wlr-layer-shell): the renderer runs as a normal window
    and the `wayland-wallpaperengine@bhuwanjoshi-01.github.io` GNOME Shell extension paints it
    as the desktop background.
  * KDE Plasma, Hyprland, Sway, niri, ... (wlr-layer-shell): linux-wallpaperengine
    draws on the background layer directly with --screen-root.

By default it follows Wallpaper Engine itself: whatever you select in the
Wallpaper Engine app (running through Proton) is shown, with the property
values you set there. `wwe set` switches to a manually chosen wallpaper and
`wwe sync` goes back to following Wallpaper Engine.
"""

import argparse
import json
import os
import random
import re
import signal
import shutil
import subprocess
import sys
import time
from pathlib import Path

APP = "wwe"
WE_APPID = "431960"
VIDEO_APP_ID = "wwe-video"
EXTENSION_UUID = "wayland-wallpaperengine@bhuwanjoshi-01.github.io"
SERVICE = "wwe.service"
VIDEO_EXTS = {".mp4", ".webm", ".mkv", ".mov", ".avi", ".m4v", ".gif"}

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / APP
CONFIG_FILE = CONFIG_DIR / "config.json"

# control sockets the GNOME extension talks to (pointer, mute)
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / APP
ENGINE_SOCKET = RUNTIME_DIR / "engine.sock"
MPV_SOCKET = RUNTIME_DIR / "mpv.sock"

DEFAULT_CONFIG = {
    "source": "wallpaper-engine",  # wallpaper-engine (follow the WE app) | manual
    "wallpaper": None,         # manual wallpaper: workshop id, project directory or video file
    "fps": 30,
    "silent": False,
    "volume": 50,              # 0-100
    "automute": False,         # also mute while other apps play audio
    "scaling": "fill",         # fill | fit | stretch | default
    "gpu": "igpu",             # igpu | dgpu (NVIDIA PRIME offload)
    "backend": "auto",         # auto | gnome | layer-shell
    "video_player": "auto",    # auto | mpv | engine
    "disable_mouse": False,
    "properties": {},          # wallpaper property overrides, name -> value
    "engine": None,            # path to linux-wallpaperengine (auto-detected)
    "extra_args": [],          # appended to the linux-wallpaperengine command line
}


# ---------------------------------------------------------------------------
# config
# ---------------------------------------------------------------------------

def load_config():
    cfg = dict(DEFAULT_CONFIG)
    if CONFIG_FILE.exists():
        try:
            cfg.update(json.loads(CONFIG_FILE.read_text()))
        except json.JSONDecodeError as e:
            die(f"{CONFIG_FILE} is not valid JSON: {e}")
    return cfg


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n")
    tmp.replace(CONFIG_FILE)


def die(msg, code=1):
    print(f"{APP}: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------------------
# Steam / workshop discovery
# ---------------------------------------------------------------------------

def steam_roots():
    home = Path.home()
    candidates = [
        home / ".steam/steam",
        home / ".local/share/Steam",
        home / "snap/steam/common/.local/share/Steam",
        home / ".var/app/com.valvesoftware.Steam/.local/share/Steam",
    ]
    seen, roots = set(), []
    for c in candidates:
        if c.exists():
            r = c.resolve()
            if r not in seen:
                seen.add(r)
                roots.append(r)
    return roots


def steam_libraries():
    """All steamapps directories, from libraryfolders.vdf of every Steam root."""
    seen, libs = set(), []

    def add(p):
        p = Path(p)
        if p.is_dir():
            r = p.resolve()
            if r not in seen:
                seen.add(r)
                libs.append(r)

    for root in steam_roots():
        add(root / "steamapps")
        vdf = root / "steamapps/libraryfolders.vdf"
        if vdf.exists():
            for m in re.finditer(r'"path"\s+"([^"]+)"', vdf.read_text(errors="replace")):
                add(Path(m.group(1).replace("\\\\", "\\")) / "steamapps")
    return libs


def assets_dir():
    for lib in steam_libraries():
        a = lib / "common/wallpaper_engine/assets"
        if a.is_dir():
            return a
    return None


def workshop_dirs():
    return [d for d in (lib / "workshop/content" / WE_APPID for lib in steam_libraries()) if d.is_dir()]


def read_project(path):
    try:
        return json.loads((Path(path) / "project.json").read_text(encoding="utf-8-sig"))
    except (OSError, json.JSONDecodeError):
        return None


def list_wallpapers():
    items = {}
    for wd in workshop_dirs():
        for d in sorted(wd.iterdir()):
            if d.name in items or not d.is_dir():
                continue
            p = read_project(d)
            if p is None:
                continue
            items[d.name] = {
                "id": d.name,
                "path": d,
                "type": str(p.get("type", "?")).lower(),
                "title": p.get("title", ""),
                "file": p.get("file"),
            }
    return list(items.values())


def resolve_wallpaper(ref):
    """Turn a workshop id / project dir / video file into a dict describing it."""
    if ref is None:
        die("no wallpaper set; run `wwe list` then `wwe set <id>`")
    ref = str(ref)
    p = Path(ref).expanduser()

    if p.is_file() and p.suffix.lower() in VIDEO_EXTS:
        return {"id": p.name, "path": p.parent, "type": "video", "title": p.name, "file": p.name, "video": p}

    if p.is_dir() and (p / "project.json").exists():
        proj = read_project(p) or {}
        item = {"id": p.name, "path": p, "type": str(proj.get("type", "?")).lower(),
                "title": proj.get("title", ""), "file": proj.get("file")}
    else:
        item = next((w for w in list_wallpapers() if w["id"] == ref), None)
        if item is None:
            die(f"wallpaper '{ref}' not found (not a workshop id, project folder or video file)")

    if item["type"] == "video" and item.get("file"):
        item["video"] = item["path"] / item["file"]
    return item


# ---------------------------------------------------------------------------
# Wallpaper Engine (Windows app via Proton) config sync
# ---------------------------------------------------------------------------

def we_config_file():
    for lib in steam_libraries():
        f = lib / "common/wallpaper_engine/config.json"
        if f.exists():
            return f
    return None


def map_we_path(path):
    """Map a path from the WE config (Proton drive letters) to a local path."""
    p = str(path).replace("\\", "/")
    i = p.lower().find("steamapps/")
    if i >= 0:
        rel = p[i + len("steamapps/"):]
        for lib in steam_libraries():
            cand = lib / rel
            if cand.exists():
                return cand
    if re.match(r"^[zZ]:/", p):  # Wine maps Z: to /
        cand = Path(p[2:])
        if cand.exists():
            return cand
    return None


def we_value(v):
    """WE property value -> linux-wallpaperengine --set-property string."""
    if isinstance(v, dict):
        v = v.get("value", "")
    if isinstance(v, bool):
        return "true" if v else "false"
    return str(v)


def we_selection():
    """What the Wallpaper Engine app has selected, or None.

    Returns {"item": <resolved wallpaper>, "properties": {...}, "monitor": key}."""
    f = we_config_file()
    if not f:
        return None
    try:
        data = json.loads(f.read_text(encoding="utf-8-sig"))
    except (OSError, json.JSONDecodeError):
        return None

    # one section per Steam account (under Proton usually "steamuser")
    for user in (v for v in data.values() if isinstance(v, dict) and "general" in v):
        selected = (user["general"].get("wallpaperconfig") or {}).get("selectedwallpapers") or {}
        for monitor, entry in selected.items():
            if not isinstance(entry, dict) or not entry.get("file"):
                continue
            local = map_we_path(entry["file"])
            if local is None:
                print(f"{APP}: cannot find {entry['file']} locally", file=sys.stderr, flush=True)
                continue
            target = local.parent if local.name == "project.json" else local
            try:
                item = resolve_wallpaper(str(target))
            except SystemExit:
                continue
            props = {}
            wprops = user.get("wproperties") or {}
            for key in (entry["file"], entry["file"].replace("/", "\\")):
                if isinstance(wprops.get(key), dict):
                    props = {k: we_value(v) for k, v in wprops[key].items()}
                    break
            return {"item": item, "properties": props, "monitor": monitor}
    return None


def current_selection(cfg):
    """(item, properties, origin) the renderer should show right now."""
    if cfg.get("source", "wallpaper-engine") == "wallpaper-engine":
        sel = we_selection()
        if sel:
            return sel["item"], sel["properties"], "wallpaper-engine"
    return resolve_wallpaper(cfg.get("wallpaper")), dict(cfg.get("properties") or {}), "manual"


# ---------------------------------------------------------------------------
# display / session detection
# ---------------------------------------------------------------------------

def detect_backend(cfg):
    if cfg.get("backend") not in (None, "auto"):
        return cfg["backend"]
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").upper()
    if os.environ.get("WAYLAND_DISPLAY") and "GNOME" in desktop:
        return "gnome"
    return "layer-shell"


def gnome_monitors():
    """Logical monitors from mutter: list of dicts (x, y, width, height, scale, primary, connector)."""
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        res = bus.call_sync("org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig",
                            "org.gnome.Mutter.DisplayConfig", "GetCurrentState",
                            None, None, Gio.DBusCallFlags.NONE, 2000, None).unpack()
    except Exception:
        return []

    _serial, monitors, logical, props = res
    physical_layout = props.get("layout-mode", 1) == 2
    modes = {}
    for (spec, mode_list, _mprops) in monitors:
        connector = spec[0]
        for (_mid, w, h, _rate, _pref, _scales, mprops) in mode_list:
            if mprops.get("is-current"):
                modes[connector] = (w, h)

    out = []
    for (x, y, scale, transform, primary, specs, _lprops) in logical:
        connector = specs[0][0] if specs else "?"
        w, h = modes.get(connector, (1920, 1080))
        if transform in (1, 3, 5, 7):  # 90 / 270 degree rotations
            w, h = h, w
        if not physical_layout:
            w, h = round(w / scale), round(h / scale)
        out.append({"x": x, "y": y, "width": w, "height": h, "scale": scale,
                    "primary": primary, "connector": connector})
    out.sort(key=lambda m: (not m["primary"], m["x"], m["y"]))
    return out


def drm_outputs():
    """Connected outputs from sysfs, named like Wayland outputs (eDP-1, HDMI-A-1, DP-2)."""
    names = []
    for status in sorted(Path("/sys/class/drm").glob("card*-*/status")):
        try:
            if status.read_text().strip() == "connected":
                names.append(status.parent.name.split("-", 1)[1])
        except OSError:
            pass
    return names


def gnome_extension_state():
    if not shutil.which("gnome-extensions"):
        return "unknown"
    r = subprocess.run(["gnome-extensions", "info", EXTENSION_UUID], capture_output=True, text=True)
    if r.returncode != 0:
        return "not-installed"
    m = re.search(r"State:\s*(\S+)", r.stdout)
    return m.group(1).lower() if m else "unknown"


# ---------------------------------------------------------------------------
# renderer command lines
# ---------------------------------------------------------------------------

def find_engine(cfg):
    for c in (cfg.get("engine"),
              Path.home() / ".local/opt/linux-wallpaperengine/linux-wallpaperengine",
              shutil.which("linux-wallpaperengine")):
        if c and Path(c).is_file() and os.access(c, os.X_OK):
            return str(c)
    return None


def gpu_env(cfg, env):
    if cfg.get("gpu") == "dgpu":
        env["__NV_PRIME_RENDER_OFFLOAD"] = "1"
        env["__GLX_VENDOR_LIBRARY_NAME"] = "nvidia"
        egl = Path("/usr/share/glvnd/egl_vendor.d/10_nvidia.json")
        if egl.exists():
            env["__EGL_VENDOR_LIBRARY_FILENAMES"] = str(egl)
        env["__VK_LAYER_NV_optimus"] = "NVIDIA_only"
    return env


def engine_common_args(cfg, properties):
    args = ["--fps", str(cfg["fps"])]
    if cfg.get("silent"):
        args.append("--silent")
    else:
        # linux-wallpaperengine volume is 0-128 (SDL_MIX_MAXVOLUME)
        args += ["--volume", str(round(max(0, min(100, int(cfg["volume"]))) * 1.28))]
    if not cfg.get("automute"):
        args.append("--noautomute")
    if cfg.get("disable_mouse"):
        # without mouse input, camera parallax parks the camera off-centre and
        # exposes the scene's clear colour along two edges
        args += ["--disable-mouse", "--disable-parallax"]
    a = assets_dir()
    if a:
        args += ["--assets-dir", str(a)]
    for k, v in properties.items():
        args += ["--set-property", f"{k}={v}"]
    return args


def build_command(cfg, item, backend, properties):
    """Return (argv, env) for the renderer."""
    env = gpu_env(cfg, dict(os.environ))
    scaling = cfg.get("scaling", "fill")

    if backend == "gnome":
        mons = gnome_monitors()
        mon = mons[0] if mons else {"width": 1920, "height": 1080}
        w, h = mon["width"], mon["height"]

        use_mpv = item["type"] == "video" and cfg.get("video_player", "auto") in ("auto", "mpv") \
            and shutil.which("mpv") and item.get("video")
        if use_mpv:
            argv = ["mpv",
                    f"--wayland-app-id={VIDEO_APP_ID}", f"--title={VIDEO_APP_ID}",
                    "--force-window=immediate", f"--geometry={w}x{h}", "--auto-window-resize=no",
                    "--no-border", "--keepaspect-window=no",
                    "--loop-file=inf", "--no-osc", "--osd-level=0", "--no-input-default-bindings",
                    "--input-vo-keyboard=no", "--cursor-autohide=always", "--really-quiet",
                    "--hwdec=auto-safe", "--stop-screensaver=no",
                    # the extension mutes us while the desktop is not focused
                    f"--input-ipc-server={MPV_SOCKET}"]
            if scaling == "fill":
                argv.append("--panscan=1.0")
            elif scaling == "stretch":
                argv.append("--keepaspect=no")
            if cfg.get("silent"):
                argv.append("--aid=no")
            else:
                argv.append(f"--volume={cfg['volume']}")
            argv.append(str(item["video"]))
            return argv, env

        engine = find_engine(cfg)
        if not engine:
            die("linux-wallpaperengine not found; run scripts/build-engine.sh")
        argv = [engine, "--window", f"0x0x{w}x{h}", "--scaling", scaling,
                # GNOME has no fullscreen detection protocol; the extension pauses us instead
                "--no-fullscreen-pause"]
        argv += engine_common_args(cfg, properties) + list(cfg.get("extra_args") or []) + [str(item["path"])]
        # the hidden window gets no input; the extension sends pointer / mute here
        env["WWE_CONTROL_SOCKET"] = str(ENGINE_SOCKET)
        return argv, env

    # layer-shell (KDE, wlroots) and X11: linux-wallpaperengine draws on the background itself
    engine = find_engine(cfg)
    if not engine:
        die("linux-wallpaperengine not found; run scripts/build-engine.sh")
    outputs = drm_outputs() or ["eDP-1"]
    argv = [engine]
    for o in outputs:
        argv += ["--screen-root", o, "--bg", str(item["path"]), "--scaling", scaling]
    argv += engine_common_args(cfg, properties) + list(cfg.get("extra_args") or [])
    return argv, env


# ---------------------------------------------------------------------------
# systemd helpers
# ---------------------------------------------------------------------------

def systemctl(*args, check=False):
    return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, check=check)


def service_installed():
    return systemctl("cat", SERVICE).returncode == 0


def apply_now():
    if service_installed():
        systemctl("restart", SERVICE)
        print("wallpaper applied (wwe.service restarted)")
    else:
        print("wwe.service not installed; run `wwe run` in a terminal or ./install.sh")


# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

def cmd_list(args):
    items = list_wallpapers()
    if args.type:
        items = [i for i in items if i["type"] == args.type]
    if args.json:
        print(json.dumps([{**i, "path": str(i["path"])} for i in items], indent=2))
        return
    if not items:
        print("no Wallpaper Engine workshop items found (subscribe to some in Steam first)")
        return
    current = str(load_config().get("wallpaper"))
    for i in items:
        mark = "*" if i["id"] == current else " "
        print(f"{mark} {i['id']:>12}  {i['type']:<6} {i['title']}")


def cmd_set(args):
    cfg = load_config()
    item = resolve_wallpaper(args.wallpaper)
    p = Path(args.wallpaper).expanduser()
    cfg["wallpaper"] = str(p.resolve()) if p.exists() else str(args.wallpaper)
    cfg["source"] = "manual"
    for key in ("fps", "scaling", "volume", "gpu"):
        v = getattr(args, key, None)
        if v is not None:
            cfg[key] = v
    if args.volume is not None:
        cfg["silent"] = False
    if args.silent:
        cfg["silent"] = True
    if args.property:
        props = {}
        for kv in args.property:
            k, _, v = kv.partition("=")
            props[k] = v
        cfg["properties"] = props
    elif not args.keep_properties:
        cfg["properties"] = {}
    save_config(cfg)
    print(f"wallpaper: {item['title'] or item['id']} ({item['type']})")
    apply_now()


def cmd_random(args):
    items = list_wallpapers()
    if args.type:
        items = [i for i in items if i["type"] == args.type]
    if not items:
        die("no wallpapers found")
    cfg = load_config()
    choices = [i for i in items if i["id"] != str(cfg.get("wallpaper"))] or items
    item = random.choice(choices)
    cfg["wallpaper"] = item["id"]
    cfg["source"] = "manual"
    cfg["properties"] = {}
    save_config(cfg)
    print(f"wallpaper: {item['title']} ({item['type']})")
    apply_now()


def cmd_pick(_args):
    if not shutil.which("zenity"):
        die("zenity is not installed; use `wwe list` and `wwe set <id>`")
    items = list_wallpapers()
    argv = ["zenity", "--list", "--title=Wayland Wallpaper Engine", "--text=Pick a wallpaper",
            "--width=720", "--height=560", "--column=ID", "--column=Type", "--column=Title",
            "--print-column=1"]
    for i in items:
        argv += [i["id"], i["type"], i["title"] or "-"]
    r = subprocess.run(argv, capture_output=True, text=True)
    choice = r.stdout.strip().split("|")[0]
    if r.returncode != 0 or not choice:
        return
    cfg = load_config()
    cfg["wallpaper"] = choice
    cfg["source"] = "manual"
    cfg["properties"] = {}
    save_config(cfg)
    apply_now()


def cmd_properties(args):
    cfg = load_config()
    item = resolve_wallpaper(args.wallpaper) if args.wallpaper else current_selection(cfg)[0]
    engine = find_engine(cfg)
    if not engine:
        die("linux-wallpaperengine not found")
    argv = [engine, "--list-properties"]
    a = assets_dir()
    if a:
        argv += ["--assets-dir", str(a)]
    argv.append(str(item["path"]))
    subprocess.run(argv)


def cmd_run(args):
    cfg = load_config()
    if args.wallpaper:
        cfg["source"], cfg["wallpaper"] = "manual", args.wallpaper
    backend = detect_backend(cfg)

    if args.dry_run:
        item, props, origin = current_selection(cfg)
        argv, _env = build_command(cfg, item, backend, props)
        print(f"{APP}: backend={backend} source={origin} type={item['type']} title={item['title']!r}")
        print(f"{APP}: exec {' '.join(argv)}")
        return

    if backend == "gnome" and gnome_extension_state() not in ("enabled", "active"):
        print(f"{APP}: warning: GNOME extension {EXTENSION_UUID} is not enabled; "
              "the wallpaper will show up as a normal window", file=sys.stderr, flush=True)
    RUNTIME_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    Supervisor(args.wallpaper, backend).run()


class Supervisor:
    """Runs the renderer and restarts it whenever the selection changes
    (wwe config or Wallpaper Engine's config.json)."""

    POLL_SECONDS = 1.0
    MAX_CRASHES = 3          # within CRASH_WINDOW: then wait for a new selection
    CRASH_WINDOW = 60

    def __init__(self, override, backend):
        self.override = override
        self.backend = backend
        self.child = None
        self.key = None
        self.crashes = []
        self.stopping = False

    def watched_mtimes(self):
        files = [CONFIG_FILE, we_config_file()]
        return tuple(f.stat().st_mtime if f and f.exists() else 0 for f in files)

    def desired(self):
        cfg = load_config()
        if self.override:
            cfg["source"], cfg["wallpaper"] = "manual", self.override
        item, props, origin = current_selection(cfg)
        argv, env = build_command(cfg, item, self.backend, props)
        return argv, env, item, origin

    def start(self, argv, env, item, origin):
        print(f"{APP}: backend={self.backend} source={origin} type={item['type']} "
              f"title={item['title']!r}", flush=True)
        print(f"{APP}: exec {' '.join(argv)}", flush=True)
        # own process group: the GNOME extension SIGSTOPs/SIGCONTs the whole
        # group (renderer + CEF helpers) while something is fullscreen
        self.child = subprocess.Popen(argv, env=env, start_new_session=True)

    def stop_child(self):
        if not self.child or self.child.poll() is not None:
            self.child = None
            return
        try:
            os.killpg(self.child.pid, signal.SIGCONT)  # in case it is paused
            os.killpg(self.child.pid, signal.SIGTERM)
            self.child.wait(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(self.child.pid, signal.SIGKILL)
            self.child.wait()
        except ProcessLookupError:
            pass
        self.child = None

    def on_signal(self, signum, _frame):
        self.stopping = True

    def run(self):
        signal.signal(signal.SIGTERM, self.on_signal)
        signal.signal(signal.SIGINT, self.on_signal)
        mtimes = None
        try:
            while not self.stopping:
                current = self.watched_mtimes()
                if current != mtimes:
                    mtimes = current
                    try:
                        argv, env, item, origin = self.desired()
                    except SystemExit:
                        argv = None  # nothing selected / not found; keep what is running
                    if argv and argv != self.key:
                        self.stop_child()
                        self.key = argv
                        self.crashes = []
                        self.start(argv, env, item, origin)

                if self.child and self.child.poll() is not None:
                    code = self.child.returncode
                    self.child = None
                    now = time.monotonic()
                    self.crashes = [t for t in self.crashes if now - t < self.CRASH_WINDOW] + [now]
                    if len(self.crashes) <= self.MAX_CRASHES:
                        print(f"{APP}: renderer exited ({code}), restarting", file=sys.stderr, flush=True)
                        argv, env, item, origin = self.desired()
                        self.key = argv
                        self.start(argv, env, item, origin)
                    else:
                        print(f"{APP}: renderer keeps crashing; waiting for another wallpaper",
                              file=sys.stderr, flush=True)
                time.sleep(self.POLL_SECONDS)
        finally:
            self.stop_child()


def cmd_service(action):
    def run(_args):
        r = systemctl(action, SERVICE)
        if r.stdout:
            print(r.stdout, end="")
        if r.returncode != 0:
            die(r.stderr.strip() or f"systemctl --user {action} {SERVICE} failed")
    return run


def cmd_sync(args):
    cfg = load_config()
    cfg["source"] = "manual" if args.off else "wallpaper-engine"
    save_config(cfg)
    if args.off:
        print("following the manual wallpaper (wwe set)")
        return
    sel = we_selection()
    if sel:
        print(f"following Wallpaper Engine: {sel['item']['title']} ({sel['item']['type']})")
    else:
        print("following Wallpaper Engine (nothing selected there yet; showing the manual wallpaper)")
    print("changes are picked up automatically while wwe.service runs")


def cmd_status(_args):
    r = systemctl("status", SERVICE, "--no-pager", "-n", "15")
    print(r.stdout or r.stderr, end="")


def cmd_doctor(_args):
    cfg = load_config()
    ok = lambda b: "ok  " if b else "FAIL"  # noqa: E731
    backend = detect_backend(cfg)
    print(f"session      : {os.environ.get('XDG_SESSION_TYPE', '?')} / {os.environ.get('XDG_CURRENT_DESKTOP', '?')}")
    print(f"backend      : {backend}")
    engine = find_engine(cfg)
    print(f"[{ok(engine)}] engine     : {engine or 'not found (run scripts/build-engine.sh)'}")
    a = assets_dir()
    print(f"[{ok(a)}] assets     : {a or 'Wallpaper Engine not installed in Steam (needed for scene wallpapers)'}")
    n = len(list_wallpapers())
    print(f"[{ok(n)}] workshop   : {n} items in {', '.join(map(str, workshop_dirs())) or '-'}")
    mpv = shutil.which("mpv")
    print(f"[{ok(mpv)}] mpv        : {mpv or 'not installed (needed for video wallpapers on GNOME: sudo apt install mpv)'}")
    if backend == "gnome":
        st = gnome_extension_state()
        print(f"[{ok(st in ('enabled', 'active'))}] extension  : {EXTENSION_UUID} -> {st}")
        for m in gnome_monitors():
            print(f"       monitor : {m['connector']} {m['width']}x{m['height']} @ {m['x']},{m['y']} "
                  f"scale {m['scale']:g}{' (primary)' if m['primary'] else ''}")
    else:
        print(f"       outputs : {', '.join(drm_outputs()) or '-'}")
    print(f"[{ok(service_installed())}] service    : {SERVICE} "
          f"({systemctl('is-active', SERVICE).stdout.strip() or 'unknown'})")
    wc = we_config_file()
    print(f"[{ok(wc)}] WE config  : {wc or 'Wallpaper Engine not installed in Steam'}")
    sel = we_selection()
    print(f"       WE pick : {(sel['item']['title'] + ' (' + sel['item']['type'] + ')') if sel else 'nothing selected'}")
    print(f"       source  : {cfg.get('source')}")
    print(f"       config  : {CONFIG_FILE}")
    print(f"       manual  : {cfg.get('wallpaper')}")


def main():
    ap = argparse.ArgumentParser(prog=APP, description="Live wallpapers / Wallpaper Engine on Wayland")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("list", help="list Wallpaper Engine workshop items")
    p.add_argument("--type", choices=["scene", "video", "web"])
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("set", help="set the wallpaper (workshop id, project folder or video file)")
    p.add_argument("wallpaper")
    p.add_argument("--fps", type=int)
    p.add_argument("--scaling", choices=["fill", "fit", "stretch", "default"])
    p.add_argument("--volume", type=int, help="enable sound at this volume (0-100)")
    p.add_argument("--silent", action="store_true", help="mute the wallpaper")
    p.add_argument("--gpu", choices=["igpu", "dgpu"])
    p.add_argument("-p", "--property", action="append", metavar="NAME=VALUE",
                   help="override a wallpaper property (see `wwe properties`)")
    p.add_argument("--keep-properties", action="store_true", help="keep previous property overrides")
    p.set_defaults(func=cmd_set)

    p = sub.add_parser("random", help="switch to a random workshop wallpaper")
    p.add_argument("--type", choices=["scene", "video", "web"])
    p.set_defaults(func=cmd_random)

    sub.add_parser("pick", help="choose a wallpaper in a dialog (zenity)").set_defaults(func=cmd_pick)

    p = sub.add_parser("sync", help="follow the wallpaper selected in the Wallpaper Engine app (default)")
    p.add_argument("--off", action="store_true", help="stop following; use the wwe set wallpaper")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("properties", help="list the configurable properties of a wallpaper")
    p.add_argument("wallpaper", nargs="?")
    p.set_defaults(func=cmd_properties)

    p = sub.add_parser("run", help="run the renderer in the foreground (used by wwe.service)")
    p.add_argument("wallpaper", nargs="?")
    p.add_argument("--dry-run", action="store_true", help="print the command instead of running it")
    p.set_defaults(func=cmd_run)

    for action in ("start", "stop", "restart"):
        sub.add_parser(action, help=f"{action} wwe.service").set_defaults(func=cmd_service(action))
    sub.add_parser("status", help="show wwe.service status").set_defaults(func=cmd_status)
    sub.add_parser("doctor", help="check the setup").set_defaults(func=cmd_doctor)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
