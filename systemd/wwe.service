[Unit]
Description=Wayland Wallpaper Engine renderer
Documentation=https://github.com/BhuwanJoshi-01/wayland-wallpaperengine
PartOf=graphical-session.target
After=graphical-session.target
# give up after a wallpaper keeps crashing instead of looping forever
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=exec
ExecStart=%h/.local/bin/wwe run
Restart=on-failure
RestartSec=3
# a wallpaper must never compete with what you are actually doing
Nice=10
CPUWeight=40
IOWeight=40
# GPU buffers of integrated GPUs live in system RAM and are charged here
# (a scene needs ~0.8 GB, two overlap briefly while switching). No MemoryHigh:
# throttling freezes the renderer, a hard cap just stops a runaway one.
MemoryMax=3G

[Install]
WantedBy=graphical-session.target
